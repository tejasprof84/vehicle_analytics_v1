# Copy to .env (scripts read it automatically)
DATABASE_URL=postgresql://vehicle:vehicle@127.0.0.1:5432/vehicle_analytics
DB_USER=vehicle
DB_PASSWORD=vehicle
DB_NAME=vehicle_analytics

# Input stream that DeepStream reads (published to MediaMTX by FFmpeg)
RTSP_INPUT=rtsp://127.0.0.1:8554/traffic

# Video that FFmpeg loops into MediaMTX (sample traffic clip shipped with DeepStream)
INPUT_VIDEO=/opt/nvidia/deepstream/deepstream/samples/streams/sample_720p.mp4
